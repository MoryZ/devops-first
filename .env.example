# Backend runtime config
# Service bind address
HTTP_ADDR=:8081

# Gin runtime mode: debug or release
GIN_MODE=debug

# Comma-separated trusted proxy CIDRs/IPs
TRUSTED_PROXIES=127.0.0.1,::1

# Tool executable paths
GIT_PATH=git
MVN_PATH=mvn
DOCKER_PATH=docker

# Database config
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=silenceopr@2026
DB_NAME=devops_first

